# M5PaperMono-Lite defaults. Regenerate sdkconfig from this after `idf.py fullclean`.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# --- Flash: 16 MB, QIO/OPI (matches board_build.arduino.memory_type = qio_opi) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM: 8 MB Octal ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# Allow the allocator to hand out PSRAM via malloc(); large framebuffers and the
# glyph cache request it explicitly with heap_caps_malloc(MALLOC_CAP_SPIRAM).
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- OTA: a new image boots on probation and rolls back if it never confirms ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Partition table (custom, see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- USB CDC on boot (serial console over the Type-C port) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# --- Main task stack ---
# app_main IS the kernel input loop: it drives the app lifecycle and runs the
# EPUB/ZIP/XML parsing + pagination when a book is opened. The 3.5 KB default
# overflows there (std::vector/std::string locals + tinfl). 16 KB gives margin.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- Logging (INFO by default; HAL self-test dumps at INFO) ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- libc: full printf so %f works in diagnostics (renamed from NEWLIB_ in 5.5) ---
CONFIG_LIBC_NEWLIB_NANO_FORMAT=n

# --- FATFS / SD: long filenames, UTF-8 on the API ---
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_949=y
